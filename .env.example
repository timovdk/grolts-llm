# Copy to .env at the repo root and fill in. .env is gitignored — never commit real keys.
# src/pipeline_config.py loads this file with python-dotenv on import, so every entry point
# (the vLLM runner, the transformers runner, the smoke test, the OpenAI batch submitter)
# picks it up. Real environment variables always win over what is set here.

# Hugging Face token. Needed for the gated repos (meta-llama/Llama-3.3-70B-Instruct);
# the token's account must also have accepted that model's licence on huggingface.co.
# Create one at https://huggingface.co/settings/tokens (a read token is enough).
HF_TOKEN=hf_...

# OpenAI key for src/submit_openai_batches.py.
OPENAI_API_KEY=sk-...

# Where model weights are cached. Defaults to /projects/prjs1302/hf_cache on the cluster;
# set it to a writable path elsewhere. The SLURM scripts also default this.
# HF_CACHE_DIR=/projects/prjs1302/hf_cache
